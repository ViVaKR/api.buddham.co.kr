<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- 중앙 패키지 관리는 PackageReference가 아닌 PackageVersion을 사용해야 합니다 -->
    <PackageVersion Include="FluentValidation" Version="12.2.0" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.2.0" />

    <!-- Microsoft 확장 및 ASP.NET Core 패키지 (버전 10.0.14 통일) -->
    <PackageVersion Include="Microsoft.Extensions.Identity.Stores" Version="10.0.14" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.14" />
    <PackageVersion Include="Microsoft.AspNetCore.DataProtection.StackExchangeRedis"
      Version="10.0.14" />
    <PackageVersion Include="Microsoft.AspNetCore.Identity" Version="2.3.13" />
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.14" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Core" Version="2.3.13" />
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Protocols.MessagePack" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.0.14" />

    <!-- 암호화 및 유틸리티 -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.14" />

    <!-- Entity Framework Core 및 데이터베이스 관련 -->
    <PackageVersion Include="EFCore.NamingConventions" Version="10.0.1" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL.NetTopologySuite"
      Version="10.0.3" />
    <PackageVersion Include="Pgvector.EntityFrameworkCore" Version="0.3.0" />

    <!-- 기타 라이브러리 및 gRPC -->
    <PackageVersion Include="MailKit" Version="4.18.2" />
    <PackageVersion Include="QRCoder" Version="1.8.1" />
    <PackageVersion Include="SharpCompress" Version="0.50.7" />
    <PackageVersion Include="SkiaSharp" Version="4.154.0" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux" Version="4.154.0" />
    <PackageVersion Include="Snappier" Version="1.3.1" />
    <PackageVersion Include="StackExchange.Redis" Version="3.4.29" />
    <PackageVersion Include="ViVaKR.Chat" Version="0.1.0-preview.1" />

    <!-- EF Core 도구 패키지 (옵션 복구) -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.14">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageVersion>
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageVersion>
  </ItemGroup>
</Project>
