# ============================================================
# 표준 .gitignore (.NET API + Kubernetes/Talos 프로젝트)
#
# 추적해야 하는 파일 (제외 금지):
#   Directory.Build.props, Directory.Packages.props,
#   nuget.config, global.json, *.csproj, *.slnx
# ============================================================

# --- 빌드 산출물 ---
[Bb]in/
[Oo]bj/
artifacts/
publish/
[Dd]ebug/
[Rr]elease/
*.nupkg
*.snupkg
*.nuget.props
*.nuget.targets
*.binlog
*.pdb

# --- 테스트 / 커버리지 ---
[Tt]est[Rr]esult*/
TestResults/
coverage*.json
coverage*.xml
coverage*.info
*.coverage
*.coveragexml
BenchmarkDotNet.Artifacts/

# --- 로그 / 임시 파일 ---
*.log
*.tmp
*.tmp_proj
*.cache
!?*.cache/

# --- IDE: Visual Studio / Rider / VS Code ---
.vs/
*.suo
*.user
*.userosscache
*.userprefs
*.sln.docstates
*.sln.iml
*.DotSettings.user
_ReSharper*/
.idea/
.fleet/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace
.history/
.vshistory/
.localhistory/

# --- 비밀 / 환경 설정 (절대 커밋 금지) ---
.env
.env.*
!.env.example
appsettings.*.local.json
secrets.json
*.pfx
*.pem
*.key
**/*secret*.yaml
**/*secret*.yml
**/*secrets*.json
!**/*secret*.example.yaml
!**/*secret*.example.yml
!**/*secrets*.example.json

# --- Talos / Kubernetes 클러스터 설정 ---
talosconfig
controlplane.yaml
worker.yaml
kubeconfig*

# --- OS ---
.DS_Store
.AppleDouble
.LSOverride
._*
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/
*.lnk
*.swp
*~

# --- 프로젝트별 선택 (로컬 전용으로 둘 폴더만 주석 해제) ---
docs/
scripts/
backup/
sql/
