<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
        <UserSecretsId>98242625-abf5-4364-9ff7-847a64902d00</UserSecretsId>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="../Buddham.Shared/Buddham.Shared.csproj" />
        <ProjectReference Include="../Buddham.Migrations/Buddham.Migrations.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="../.dockerignore">
            <Link>.dockerignore</Link>
        </Content>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="EFCore.NamingConventions" Version="10.0.1" />
        <PackageReference Include="Grpc.Net.ClientFactory" Version="2.84.0" />
        <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.13" />
        <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.13" />
        <PackageReference Include="Microsoft.AspNetCore.SignalR.Protocols.MessagePack"
            Version="10.0.13" />
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
        <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
        <PackageReference Include="ViVaKR.Chat" Version="0.1.0-preview.1" />
    </ItemGroup>

</Project>
